# BYOLabs Environment Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=byolabs_super_secret_jwt_key_2026_change_in_production
DATABASE_PATH=./byolabs.sqlite

# Kubernetes Cluster Configuration (Standard GKE cluster hosting all workloads)
KUBERNETES_MODE=auto # auto, k8s, or sandbox
STANDARD_K8S_CONTEXT=gke_gdg-test-458407_us-central1-a_byo-dind-cluster
KUBERNETES_NAMESPACE_PREFIX=lab-session-
DEFAULT_LAB_TIMEOUT_MINUTES=60
DEFAULT_IDLE_TIMEOUT_MINUTES=30
MAX_ACTIVE_LABS_PER_USER=2
MAX_CLUSTER_LABS=50

# Web App Configuration
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000

# Google OAuth 2.0 Authentication
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

